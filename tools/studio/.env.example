# Copy to tools/studio/.env and fill only the services you use. Every service is optional.
# Never commit .env. Keys are read at run time and never printed.

# fal.ai — image edits (looks), Seedance / Kling video, dance with face binding, music, sound effects,
# speech-to-speech, cloud singing, upscaling. https://fal.ai/dashboard/keys (prepaid credits)
FAL_KEY=

# OpenRouter — face check, storyboard lint, clip check, finding the dancer/face in frames, blind audio judging.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional model overrides
# STUDIO_VISION_MODEL=google/gemini-3-flash-preview
# STUDIO_AUDIO_MODEL=google/gemini-2.5-pro

# Volcengine Doubao TTS — voice lines. https://console.volcengine.com/speech/app
VOLC_API_KEY=
# Voice ID from the console voice list. IDs starting with S_ are your own cloned voices.
DOUBAO_SPEAKER=

# LibTV — Kling O3 multi-reference video, OmniHuman lip-sync. Install LibTV's command-line client and log in once.
# https://www.liblib.tv
LIBTV_PROJECT=
# LIBTV_BIN=~/.libtv/libtv

# Viggle — dance character swap. https://viggle.ai
VIGGLE_API_KEY=

# Volcengine Ark — Seedance directly (experimental adapter). https://console.volcengine.com/ark
ARK_API_KEY=
ARK_SEEDANCE_MODEL=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Local singing (no key): where sing/setup.sh installed Seed-VC / Applio
# SEEDVC_DIR=~/seed-vc
# APPLIO_DIR=~/Applio

# Where generated shots/audio go when not tied to a character folder (default ./studio-out)
# STUDIO_OUT=studio-out
