# Caddy site for the live room. install.sh fills {{DOMAIN}} (DOMAIN=example.com bash deploy/install.sh) and writes it to
# /etc/caddy/sites/livehost.caddy; Caddy gets the HTTPS certificate by itself once the domain points at this server.
www.{{DOMAIN}} {
    redir https://{{DOMAIN}}{uri} permanent
}

{{DOMAIN}} {
    request_body {
        max_size 16KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    # the live stream (SSE /api/live) must not be buffered
    reverse_proxy 127.0.0.1:4370 {
        flush_interval -1
        # the server limits free guest seats per visitor IP; without this every visitor is 127.0.0.1
        header_up X-Real-IP {remote_host}
        lb_try_duration 15s
        lb_try_interval 250ms
    }
    log {
        output file /var/log/caddy/livehost-access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}
